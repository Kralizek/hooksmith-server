{
  "workspace": [
    "./packages/server"
  ],
  "imports": {
    "@hooksmith/core": "jsr:@hooksmith/core@^0.10.0",
    "@hooksmith/runtime": "jsr:@hooksmith/runtime@^0.10.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno task check:docs && deno test -A && deno check packages/*/mod.ts",
    "check:docs": "deno run --allow-read=packages,extensions scripts/check_export_docs.ts",
    "test": "deno test -A",
    "server": "deno run -A packages/server/mod.ts"
  },
  "fmt": {
    "exclude": [
      "README.md"
    ]
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@hooksmith/core",
      "jsr:@hooksmith/runtime"
    ]
  },
  "lock": false
}
